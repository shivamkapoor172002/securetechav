{
  "version": 2,
  "builds": [
    {
      "src": "secure/app.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "workspace/**"
      }
    },
    {
      "src": "workspace/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/fontdata/(.*)",
      "dest": "/workspace/fontdata/$1"
    },
    {
      "src": "/workspace/?$",
      "dest": "/workspace/index.html"
    },
    {
      "src": "/workspace/(.*)",
      "dest": "/workspace/$1"
    },
    {
      "src": "/(.*)",
      "dest": "secure/app.py"
    }
  ]
}
